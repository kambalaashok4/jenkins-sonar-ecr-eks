pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: git 'https://github.com/kambalaashok4/jenkins-sonar-ecr-eks.git'
            }
        }

        stage('Setup Python') {
            steps {
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                . venv/bin/activate
                pytest --junitxml=report.xml
                '''
            }
        }
    }

    post {
        always {
            junit 'report.xml'
        }
    }
}
